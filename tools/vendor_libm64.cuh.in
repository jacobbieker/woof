__device__ __forceinline__ float cbrtf(float x) { return plm_cbrtf(x); }
// tgammaf.rs: binary64 tgamma rounded once.
__device__ __forceinline__ float tgammaf(float x) { return __double2float_rn(plm_tgamma((double)x)); }
