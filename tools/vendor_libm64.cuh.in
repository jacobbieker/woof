    const double T0 = plm_bits(0x3fdef72bc8ee38a2), T1 = plm_bits(0xbfc2e4278dc6c509), T2 = plm_bits(0x3fb08b4294d5419b), T3 = plm_bits(0xbfa0c9a8df35b713);
    const double T4 = plm_bits(0x3f9266e7970af9ec), T5 = plm_bits(0xbf851f9fba91ec6a), T6 = plm_bits(0x3f78fce0e370e344), T7 = plm_bits(0xbf6e2effb3e914d7);
    const double T8 = plm_bits(0x3f6282d32e15c915), T9 = plm_bits(0xbf56fe8ebf2d1af1), T10 = plm_bits(0x3f4cdf0cef61a8e9), T11 = plm_bits(0xbf41a6109c73e0ec);
    const double T12 = plm_bits(0x3f34af6d6c0ebbf7), T13 = plm_bits(0xbf347f24ecc38c38), T14 = plm_bits(0x3f35fd3ee8c2d3f4), U0 = plm_bits(0xbfb3c467e37db0c8);
    const double U1 = plm_bits(0x3fe4401e8b005dff), U2 = plm_bits(0x3ff7475cd119bd6f), U3 = plm_bits(0x3fef497644ea8450), U4 = plm_bits(0x3fcd4eaef6010924);
    const double U5 = plm_bits(0x3f8b678bbf2bab09), V1 = plm_bits(0x4003a5d7c2bd619c), V2 = plm_bits(0x40010725a42b18f5), V3 = plm_bits(0x3fe89dfbe45050af);
    const double V4 = plm_bits(0x3fbaae55d6537c88), V5 = plm_bits(0x3f6a5abb57d0cf61), S0 = plm_bits(0xbfb3c467e37db0c8), S1 = plm_bits(0x3fcb848b36e20878);
    const double S2 = plm_bits(0x3fd4d98f4f139f59), S3 = plm_bits(0x3fc2bb9cbee5f2f7), S4 = plm_bits(0x3f9b481c7e939961), S5 = plm_bits(0x3f5e26b67368f239);
    const double S6 = plm_bits(0x3f00bfecdd17e945), R1 = plm_bits(0x3ff645a762c4ab74), R2 = plm_bits(0x3fe71a1893d3dcdc), R3 = plm_bits(0x3fc601edccfbdf27);
    const double R4 = plm_bits(0x3f9317ea742ed475), R5 = plm_bits(0x3f497ddaca41a95b), R6 = plm_bits(0x3edebaf7a5b38140), W0 = plm_bits(0x3fdacfe390c97d69);
    const double W1 = plm_bits(0x3fb555555555553b), W2 = plm_bits(0xbf66c16c16b02e5c), W3 = plm_bits(0x3f4a019f98cf38b6), W4 = plm_bits(0xbf4380cb8c0fe741);
    const double W5 = plm_bits(0x3f4b67ba4cdad5d1), W6 = plm_bits(0xbf5ab89d0b9e43e4);
    unsigned long long u = plm_word(x);
    double t, y, z, nadj, p, p1, p2, p3, q, r, w;
    int i;
    bool sign = (u >> 63) != 0;
    unsigned ix = (unsigned)(u >> 32) & 0x7fffffff;
    if (ix >= 0x7ff00000) return D(x * x);
    if (ix < ((0x3ffu - 70u) << 20)) {
        if (sign) x = plm_negd(x);
        return plm_negd(plm_log(x));
    }
    if (sign) {
        x = plm_negd(x);
        t = plm_lgamma_sin_pi(x);
        if (t == 0.0) return D(1.0 / (x - x));
        if (!(t > 0.0)) t = plm_negd(t);
        nadj = plm_log(D(PI / (t * x)));
    } else {
        nadj = 0.0;
    }
    if ((ix == 0x3ff00000 || ix == 0x40000000) && (u & 0xffffffffULL) == 0) {
        r = 0.0;
    } else if (ix < 0x40000000) {
        if (ix <= 0x3feccccc) {
            r = plm_negd(plm_log(x));
            if (ix >= 0x3FE76944) { y = D(1.0 - x); i = 0; }
            else if (ix >= 0x3FCDA661) { y = D(x - (TC - 1.0)); i = 1; }
            else { y = x; i = 2; }
        } else {
            r = 0.0;
            if (ix >= 0x3FFBB4C3) { y = D(2.0 - x); i = 0; }
            else if (ix >= 0x3FF3B4C4) { y = D(x - TC); i = 1; }
            else { y = D(x - 1.0); i = 2; }
        }
        if (i == 0) {
            z = D(y * y);
            p1 = D(A0 + z * (A2 + z * (A4 + z * (A6 + z * (A8 + z * A10)))));
            p2 = D(z * (A1 + z * (A3 + z * (A5 + z * (A7 + z * (A9 + z * A11))))));
            p = D(y * p1 + p2);
            r = D(r + (p - 0.5 * y));
        } else if (i == 1) {
            z = D(y * y);
            w = D(z * y);
            p1 = D(T0 + w * (T3 + w * (T6 + w * (T9 + w * T12))));
            p2 = D(T1 + w * (T4 + w * (T7 + w * (T10 + w * T13))));
            p3 = D(T2 + w * (T5 + w * (T8 + w * (T11 + w * T14))));
            p = D(z * p1 - (TT - w * (p2 + y * p3)));
            r = D(r + (TF + p));
        } else {
            p1 = D(y * (U0 + y * (U1 + y * (U2 + y * (U3 + y * (U4 + y * U5))))));
            p2 = D(1.0 + y * (V1 + y * (V2 + y * (V3 + y * (V4 + y * V5)))));
            r = D(r + (-0.5 * y + p1 / p2));
        }
    } else if (ix < 0x40200000) {
        i = plm_i32(x);
        y = D(x - __int2double_rn(i));
        p = D(y * (S0 + y * (S1 + y * (S2 + y * (S3 + y * (S4 + y * (S5 + y * S6)))))));
        q = D(1.0 + y * (R1 + y * (R2 + y * (R3 + y * (R4 + y * (R5 + y * R6))))));
        r = D(0.5 * y + p / q);
        z = 1.0;
        if (i >= 7) z = D(z * (y + 6.0));
        if (i >= 6) z = D(z * (y + 5.0));
        if (i >= 5) z = D(z * (y + 4.0));
        if (i >= 4) z = D(z * (y + 3.0));
        if (i >= 3) { z = D(z * (y + 2.0)); r = D(r + plm_log(z)); }
    } else if (ix < 0x43900000) {
        t = plm_log(x);
        z = D(1.0 / x);
        y = D(z * z);
        w = D(W0 + z * (W1 + y * (W2 + y * (W3 + y * (W4 + y * (W5 + y * W6))))));
        r = D((x - 0.5) * (t - 1.0) + w);
    } else {
        r = D(x * (plm_log(x) - 1.0));
    }
    if (sign) r = D(nadj - r);
