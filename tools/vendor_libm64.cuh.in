__device__ __forceinline__ double sin(double x) { return wcr_sin(x); }
__device__ __forceinline__ double atan(double x) { return wcr_atan(x); }
__device__ __forceinline__ double pow(double x, double y) { return wcr_pow(x, y); }
__device__ __forceinline__ double atan2(double y, double x) { return plm_atan2(y, x); }
__device__ __forceinline__ double hypot(double x, double y) { return plm_hypot(x, y); }
__device__ __forceinline__ double log2(double x) { return plm_log2(x); }
__device__ __forceinline__ double expm1(double x) { return plm_expm1(x); }
__device__ __forceinline__ double tanh(double x) { return plm_tanh(x); }
__device__ __forceinline__ double tgamma(double x) { return plm_tgamma(x); }
__device__ __forceinline__ double lgamma(double x) { return plm_lgamma(x); }
